# NoneBot2（~fastapi 需要在 Bot 项目另行安装 nonebot2[fastapi]）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
COMMAND_START=["/"]
ONEBOT_ACCESS_TOKEN=

# 聊天模型（OpenAI 兼容接口）。留空时插件可以正常导入，但调用聊天功能前必须配置。
GROUP_CHAT_MEMORY_CHAT_BASE_URL=
GROUP_CHAT_MEMORY_CHAT_API_KEY=
GROUP_CHAT_MEMORY_CHAT_MODEL=deepseek-v4.1-flash
GROUP_CHAT_MEMORY_CHAT_TIMEOUT=60

# Embedding（OpenAI 兼容接口）。群聊原文会发送到该服务商用于向量化。
GROUP_CHAT_MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
GROUP_CHAT_MEMORY_EMBEDDING_API_KEY=
GROUP_CHAT_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
GROUP_CHAT_MEMORY_EMBEDDING_DIMENSIONS=1024
GROUP_CHAT_MEMORY_EMBEDDING_TIMEOUT=10
# 回复前查询向量的独立短超时（秒）；超时立即降级为最近消息
GROUP_CHAT_MEMORY_QUERY_TIMEOUT=3

# 数据库路径覆盖；留空时使用 nonebot-plugin-localstore 的插件数据目录。
GROUP_CHAT_MEMORY_DB_PATH_OVERRIDE=

# 上下文与记忆参数
GROUP_CHAT_MEMORY_RECENT_MESSAGES=20
GROUP_CHAT_MEMORY_CHUNK_SIZE=10
GROUP_CHAT_MEMORY_LONG_TERM_MEMORIES=5
GROUP_CHAT_MEMORY_CONTEXT_MAX_CHARS=6000

# 新群默认随机回复概率（0～100，0 表示关闭）
GROUP_CHAT_MEMORY_DEFAULT_PROBABILITY=0

# 系统提示词（留空时仅使用内置发言者区分和当前消息约束）
# GROUP_CHAT_MEMORY_SYSTEM_PROMPT=你是一个群聊助手，回答自然、简洁。

# 不参与对话和记忆的已知机器人 QQ 号（JSON 数组）
GROUP_CHAT_MEMORY_IGNORED_QQ=[]
