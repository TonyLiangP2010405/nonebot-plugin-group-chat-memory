# NoneBot2（~fastapi 需要在 Bot 项目另行安装 nonebot2[fastapi]）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
COMMAND_START=["/"]
ONEBOT_ACCESS_TOKEN=

# 聊天地址、聊天密钥、聊天模型、向量密钥、语音密钥、阿里云密钥/空间/参考音频
# 不再使用环境变量。启动后由 SUPERUSER 在私聊中设置，例如：
# /设置聊天地址、/设置聊天密钥、/设置聊天模型、/设置向量密钥、
# /设置语音模型、/设置语音密钥、/设置阿里云密钥、/设置阿里云空间、/设置语音参考。
GROUP_CHAT_MEMORY_CHAT_TIMEOUT=60

# 语音合成：DeepSeek TTS 或阿里云 Qwen-Audio-3.1-TTS-Next。
# 待朗读的回复文本会发送到当前语音服务；Qwen 还会上传 /设置语音参考 的参考音频。
GROUP_CHAT_MEMORY_TTS_BASE_URL=https://api.deepseek.com/v1/tools/tts
GROUP_CHAT_MEMORY_TTS_TIMEOUT=30
# 千问/百炼地域与模型 ID；Key 和参考音频用命令配置，业务空间仅百炼需要。
# 可用 /生成馒头音色 生成固定的原创“馒头”音色，不依赖真人参考音频。
GROUP_CHAT_MEMORY_QWEN_REGION=cn-beijing
GROUP_CHAT_MEMORY_QWEN_MODEL=qwen-audio-3.1-tts-next
GROUP_CHAT_MEMORY_QWEN_TIMEOUT=120

# Embedding（OpenAI 兼容接口）。群聊原文会发送到该服务商用于向量化。
GROUP_CHAT_MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
GROUP_CHAT_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
GROUP_CHAT_MEMORY_EMBEDDING_DIMENSIONS=1024
GROUP_CHAT_MEMORY_EMBEDDING_TIMEOUT=10
# 回复前查询向量的独立短超时（秒）；超时立即降级为最近消息
GROUP_CHAT_MEMORY_QUERY_TIMEOUT=3

# 数据库路径覆盖；留空时使用 nonebot-plugin-localstore 的插件数据目录。
GROUP_CHAT_MEMORY_DB_PATH_OVERRIDE=

# 上下文与记忆参数
GROUP_CHAT_MEMORY_RECENT_MESSAGES=20
GROUP_CHAT_MEMORY_CHUNK_SIZE=10
GROUP_CHAT_MEMORY_LONG_TERM_MEMORIES=5
GROUP_CHAT_MEMORY_CONTEXT_MAX_CHARS=6000

# 新群默认随机回复概率（0～100，0 表示关闭）
GROUP_CHAT_MEMORY_DEFAULT_PROBABILITY=0

# 新群默认每小时模型请求上限（1～10000）；已有群可用 /每小时次数 修改
GROUP_CHAT_MEMORY_HOURLY_REQUEST_LIMIT=10

# 覆盖默认的“馒头 + 黑猫式性格”人格；留空时仅使用内置发言者区分和当前消息约束
# GROUP_CHAT_MEMORY_SYSTEM_PROMPT=你是一个群聊助手，回答自然、简洁。

# 不参与对话和记忆的已知机器人 QQ 号（JSON 数组）
GROUP_CHAT_MEMORY_IGNORED_QQ=[]

# 表情包：好感榜前 3 名触发回复时附图；SUPERUSER 100% 触发并附图
# 这里是全局默认值；单个群可用 /表情包开关 关 单独关闭
GROUP_CHAT_MEMORY_MEME_ENABLED=true
# B站视频回复：榜一和 /语音名单 成员抽到时，由模型判断是否搜索并转发视频
# GROUP_CHAT_MEMORY_VIDEO_ENABLED=true
GROUP_CHAT_MEMORY_MEME_API_URL=https://cn.apihz.cn/api/img/apihzbqbbaidu.php
# 接口盒子的数字 ID 与通讯 KEY 不再使用环境变量。
# 启动后由 SUPERUSER 在私聊中使用 /设置表情包ID、/设置表情包密钥。
